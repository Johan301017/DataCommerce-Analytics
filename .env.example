# ============================================================
# DataCommerce Analytics - Variables de entorno
# Copie este archivo como ".env" (en la raíz del proyecto o en backend/)
# y reemplace los valores. El archivo .env NO debe subirse al repositorio.
# ============================================================

# Conexión a MySQL 8.0
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambie_esta_clave
DB_NAME=datacommerce_analytics

# Fecha de corte para la segmentación premium (RFM), formato AAAA-MM-DD
FECHA_CORTE=2026-11-18

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Solo para docker-compose: contraseña del usuario root del contenedor MySQL
MYSQL_ROOT_PASSWORD=cambie_esta_clave
